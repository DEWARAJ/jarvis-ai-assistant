# JARVIS OS environment template.
# NEVER commit a real .env. JARVIS NEVER stores keys in memory or config — only here.
# Local Ollama needs NO key. Add a key only for the cloud brain you want to use.

# --- Perplexity (live web search, current info) ---  https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# --- Claude / Anthropic (deepest reasoning) ---      https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- NVIDIA NIM (free cloud tier) ---                https://build.nvidia.com
NVIDIA_API_KEY=

# --- Google AI Studio (Gemini) ---                   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Firecrawl (web scraping/crawling) ---           https://firecrawl.dev
FIRECRAWL_API_KEY=

# --- Future business connectors (leave blank until approved) ---
SHOPIFY_API_KEY=
META_ADS_TOKEN=
GMAIL_OAUTH=

# Email reading (read-only). Gmail App Password (2-step verification must be ON):
#   https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
